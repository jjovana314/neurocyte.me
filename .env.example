# Single env file for the whole repo (api, frontend, calculator).
# Copy to `.env` in the repo root and fill in real values.

# Database
DATABASE_URL=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=test_name
DATABASE_PASSWORD=test_pwd
DATABASE_NAME=neurocyte

# Auth
SECRET_KEY=test_key
ACCESS_TOKEN_TIME=15m
REFRESH_TOKEN_TIME=7d

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=noreply@example.com

# URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Calculator gRPC service
CALCULATOR_GRPC_PORT=50051
CALCULATOR_GRPC_URL=localhost:50051

# Frontend: only variables prefixed with VITE_ are exposed to the browser.
